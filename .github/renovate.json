{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // https://docs.renovatebot.com/presets-config/#configbest-practices
  "extends": ["config:best-practices", "config:semverAllMonthly"],
  // Actions are locked by .github/workflows/actions.lock, so keep tag refs.
  "ignorePresets": ["helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  // flake.lock is updated by `just update`, which picks a nixpkgs commit at least 7 days old.
  "nix": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    // Lock refreshes have no release timestamp, so Renovate's age check never passes.
    // uv's `exclude-newer = "1 week"` enforces the cooldown on uv.lock instead.
    "minimumReleaseAge": null,
    "schedule": ["* 0-3 1 * *"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the gh-actions-lock extension pinned in the lockfile workflow",
      "managerFilePatterns": ["/^\\.github/workflows/lockfile\\.yml$/"],
      "matchStrings": ["gh-actions-lock --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
